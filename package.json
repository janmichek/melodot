{
  "name": "beatchain",
  "version": "1.0.0",
  "description": "Decentralized music discovery and tipping platform on blockchain",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vercel dev",
    "build": "tsc && vite build",
    "generate": "wagmi generate",
    "test:api": "bun run api/test.ts",
    "test:api:all": "bun run test:api",
    "test:e2e": "playwright test",
    "test:contract": "cd contracts && bun install && bun run test",
    "deploy-contract": "cd contracts && bun install && bun run deploy-contract && cd .. && bun run generate",
    "clean-contract": "cd contracts && npx hardhat clean && rm -rf artifacts  && rm -rf artifacts-pvm && rm -rf cache && rm -rf cache-pvm && rm -rf typechain-types && rm -rf ignition/deployments && npx hardhat ignition wipe",
    "reinstall": "rm -rf node_modules/ && bun pm cache rm && bun install",
    "test:all": "bun run test:contract && bun run test:api:all && bun run test:e2e"
  },
  "dependencies": {
    "@metamask/jazzicon": "^2.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.7",
    "@web3auth/modal": "^10.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "formidable": "^3.5.4",
    "lucide-react": "^0.553.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "tailwind-merge": "^3.4.0",
    "viem": "^2.38.6",
    "wagmi": "^2.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/formidable": "^3.4.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@wagmi/cli": "^2.7.1",
    "@types/node": "^24.10.0",
    "@vercel/node": "^5.5.5",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
