{
  "name": "my-polkadot-cistej",
  "version": "1.0.0",
  "description": "Polkadot project with contracts and frontend",
  "private": true,
  "dependencies": {
    "@metamask/jazzicon": "^2.0.0",
    "@types/node": "^24.10.0",
    "@vercel/node": "^5.5.4",
    "formidable": "^3.5.4"
  },
  "scripts": {
    "install": "cd contracts && bun install && cd ../frontend && bun install",
    "deploy-contract": "cd contracts && bun run deploy-contract && cd ../frontend && bun run generate",
    "test:contract": "cd contracts && bun run test",
    "test:e2e": "cd frontend && bun run test:e2e",
    "test:unit": "cd frontend && bun run test:unit",
    "test:api": "cd api && bun run test:unit",
    "dev": "cd frontend && bun run dev",
    "start": "cd frontend && bun run dev",
    "vercel-build": "cd frontend && bun run build",
    "build": "cd frontend && bun run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
