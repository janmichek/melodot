{
  "name": "melodot",
  "version": "1.0.0",
  "description": "Award-winning - decentralized music discovery and tipping platform on Polkadot. Record audio, identify songs, and directly tip artists via smart contracts.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vercel dev",
    "build": "tsc && vite build",
    "generate": "cd contracts && forge build && cd .. && wagmi generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:all": "bun run test:contract && bun run test:api && bun run test:e2e",
    "test:api": "bun run api/test.ts",
    "test:e2e": "playwright test",
    "test:contract": "cd contracts && forge test -vvv",
    "test:contract:ci": "cd contracts && forge test --profile ci -vvv",
    "test:contract:coverage": "cd contracts && forge coverage",
    "reinstall": "rm -rf node_modules/ && bun pm cache rm && bun install",
    "contract:deploy": "cd contracts && forge script script/Deploy.s.sol:Deploy --rpc-url https://testnet-passet-hub-eth-rpc.polkadot.io --broadcast && cd .. && bun run generate",
    "contract:redeploy": "bun contract:clean && bun contract:deploy",
    "contract:clean": "cd contracts && forge clean"
  },
  "dependencies": {
    "@metamask/jazzicon": "^2.0.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.9",
    "@web3auth/modal": "^10.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "formidable": "^3.5.4",
    "lucide-react": "^0.553.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "tailwind-merge": "^3.4.0",
    "vercel": "^58.7.1",
    "viem": "^2.39.0",
    "wagmi": "^2.19.4"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/formidable": "^3.4.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.5.6",
    "@vitejs/plugin-react": "^5.1.1",
    "@wagmi/cli": "^2.8.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
