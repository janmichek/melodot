{
  "name": "donalyze",
  "version": "1.0.0",
  "description": "Award-winning - decentralized music discovery and tipping platform on Polkadot. Record audio, identify songs, and directly tip artists via smart contracts.",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite --config config/vite.config.ts",
    "start": "vite --config config/vite.config.ts",
    "build": "tsc && vite build --config config/vite.config.ts",
    "generate": "cd contracts && forge build && cd .. && wagmi generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:all": "bun run test:unit && bun run test:contract && bun run test:api && bun run test:e2e",
    "test:unit": "vitest run --config config/vitest.config.ts",
    "test:coverage": "vitest run --config config/vitest.config.ts --coverage",
    "test:api": "bun run api/test.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "test:contract": "cd contracts && forge test -vvv",
    "test:contract:ci": "cd contracts && forge test --profile ci -vvv",
    "test:contract:coverage": "cd contracts && forge coverage",
    "check:static": "bun run typecheck && bun run lint && bun run build",
    "validate": "bun run check:static && bun run test:unit && bun run test:contract",
    "audit": "bun audit --production",
    "slither": "cd contracts && slither . --config-file slither.config.json",
    "reinstall": "rm -rf node_modules/ && bun pm cache rm && bun install",
    "contract:deploy": "cd contracts && forge script script/Deploy.s.sol:Deploy --rpc-url polkadotHubTestnet --broadcast && cd .. && bun run contract:sync && bun run generate",
    "contract:sync": "bun run scripts/sync-deployment.ts",
    "contract:redeploy": "bun contract:clean && bun contract:deploy",
    "contract:clean": "cd contracts && forge clean"
  },
  "dependencies": {
    "@metamask/jazzicon": "^2.0.0",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.108.4",
    "@web3auth/modal": "^10.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "formidable": "^3.5.4",
    "lucide-react": "^1.82.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "tailwind-merge": "^3.7.1",
    "viem": "^2.58.8",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/formidable": "^3.5.1",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^34.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "@wagmi/cli": "^2.10.1",
    "autoprefixer": "^10.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.34",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vercel": "^68.0.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "ws": "^8.21.0",
    "decode-uri-component": "^0.5.0",
    "zod": "^4.6.6"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
