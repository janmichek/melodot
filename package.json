{
  "name": "beatchain",
  "version": "1.0.0",
  "description": "Decentralized music discovery and tipping platform on blockchain",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint",
    "generate": "wagmi generate",
    "test": "vitest",
    "test:api": "cd api && bun run test:unit",
    "test:unit": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:contract": "cd contracts && bun install &&cd contracts && bun run test",
    "deploy-contract": "cd contracts && bun install && bun run deploy-contract && bun run generate",
    "reinstall": "rm -rf node_modules/ && bun pm cache rm && bun install",
    "reboot": "bun reinstall && bun dev",
    "upgrade": "ncu -u && bun reinstal"
  },
  "dependencies": {
    "@metamask/jazzicon": "^2.0.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.37.1",
    "@types/node": "^24.10.0",
    "@vercel/node": "^5.5.4",
    "@web3auth/modal": "^10.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "formidable": "^3.5.4",
    "lucide-react": "^0.552.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.5",
    "tailwind-merge": "^3.3.1",
    "wagmi": "^2.14.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/formidable": "^3.4.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@wagmi/cli": "^2.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.4",
    "viem": "^2.38.3",
    "vite": "^5.4.0",
    "vitest": "^4.0.7"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
