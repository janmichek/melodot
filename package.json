{
  "name": "my-polkadot-cistej",
  "version": "1.0.0",
  "description": "Polkadot project with contracts and frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint",
    "generate": "wagmi generate",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "install": "cd contracts && bun install",
    "deploy-contract": "cd contracts && bun run deploy-contract && bun run generate",
    "test:contract": "cd contracts && bun run test",
    "test:api": "cd api && bun run test:unit",
    "start": "vite"
  },
  "dependencies": {
    "@metamask/jazzicon": "^2.0.0",
    "@polkadot/ui-identicon": "^0.41.1",
    "@polkadot/ui-shared": "^3.16.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.37.1",
    "@types/node": "^24.10.0",
    "@vercel/node": "^5.5.4",
    "@web3auth/modal": "^10.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "formidable": "^3.5.4",
    "jdenticon": "^3.3.0",
    "lucide-react": "^0.552.0",
    "multer": "^2.0.2",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "wagmi": "^2.14.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/formidable": "^3.4.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@wagmi/cli": "^2.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.4",
    "viem": "^2.38.3",
    "vite": "^5.4.0",
    "vitest": "^4.0.7"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
