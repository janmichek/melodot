{
  "buildCommand": "bun install && cd frontend && bun run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "bun install && cd frontend && bun install",
  "devCommand": "cd frontend && bun run dev",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@3.2.29"
    }
  }
}