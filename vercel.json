{
  "framework": null,
  "buildCommand": "bun install && bun run build",
  "outputDirectory": "dist",
  "installCommand": "bun install",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@3.2.29"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
