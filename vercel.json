{
  "framework": null,
  "buildCommand": "bun install && bun run build",
  "outputDirectory": "dist",
  "installCommand": "bun install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(self)"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/discover",
      "destination": "/api/endpoints/discover"
    },
    {
      "source": "/api/track",
      "destination": "/api/endpoints/track"
    },
    {
      "source": "/api/bio",
      "destination": "/api/endpoints/bio"
    },
    {
      "source": "/api/artist",
      "destination": "/api/endpoints/artist"
    },
    {
      "source": "/api/artists",
      "destination": "/api/endpoints/artists"
    },
    {
      "source": "/api/verify",
      "destination": "/api/endpoints/verify"
    },
    {
      "source": "/api/rpc",
      "destination": "/api/endpoints/rpc"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
