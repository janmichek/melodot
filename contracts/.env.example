# Never commit the real .env file.

# Contract owner and platform fee recipient used by script/Deploy.s.sol.
OWNER=

# Address that signs EIP-712 claim authorisations used by `claimArtist`.
CLAIM_SIGNER=

# Optional Foundry signer. Prefer a keystore account:
#   cast wallet import donalyze --interactive
#   forge script ... --account donalyze --broadcast
PRIVATE_KEY=
