{
  "name": "melodot-contracts",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "forge test",
    "test:ci": "forge test --profile ci -vvv",
    "test:gas": "forge test --gas-report",
    "coverage": "forge coverage",
    "build": "forge build --sizes",
    "fmt": "forge fmt",
    "fmt:check": "forge fmt --check",
    "lint": "forge lint",
    "clean": "forge clean",
    "install:libs": "forge install foundry-rs/forge-std --no-git --shallow && forge install OpenZeppelin/openzeppelin-contracts@v5.4.0 --no-git --shallow",
    "deploy": "forge script script/Deploy.s.sol:Deploy --rpc-url https://testnet-passet-hub-eth-rpc.polkadot.io --broadcast"
  }
}
