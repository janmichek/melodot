# https://rapidapi.com/ (server-side only; do not prefix with VITE_)
RAPIDAPI_KEY=

# https://dashboard.web3auth.io/
VITE_WEB3AUTH_CLIENT_ID=

# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

VERIFICATION_SECRET=

# Deployed Donate contract (falls back to contracts/deployments JSON)
VITE_CONTRACT_ADDRESS=

# Claim authorisation signer (server-side; must match CLAIM_SIGNER on-chain)
CLAIM_SIGNER_PRIVATE_KEY=
CLAIM_CONTRACT_ADDRESS=

# Comma-separated browser origins allowed to call the RPC proxy
APP_ORIGINS=https://donalyze.vercel.app

# Contract deployment variables live in contracts/.env (see contracts/.env.example)
