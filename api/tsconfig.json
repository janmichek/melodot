{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "strict": false,
    "moduleResolution": "bundler",
    "baseUrl": "..",
    "paths": {
      "@types": ["./types"]
    }
  },
  "include": ["*.ts", "**/*.ts"],
  "exclude": ["node_modules"]
}
